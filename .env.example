# Sao chép thành .env (Node) hoặc khai báo trong Apps Script > Project Settings > Script Properties.
# KHÔNG commit giá trị thật.

# TikTok Affiliate Partner (TAP)
TAP_BASE_URL=https://api-partner-sg.tiktokshop.com
